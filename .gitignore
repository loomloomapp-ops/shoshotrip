# Local reference-only material (photos, .MOV clips, exported Webflow template).
# Not part of the deployable site — keep it out of the repo. Both spellings:
# the working folder on disk is "asets", and it holds multi-GB camera originals.
/assets
/asets

# Static-export lead secrets + runtime log (live only on the server)
/public/lead.config.php
/public/leads.log

# Admin panel server-side state: GitHub token, password hash, lockout counter.
# These are created on the server and must never reach the repository.
/public/admin.config.php
/public/admin.auth.php
/public/admin.lockout.json

