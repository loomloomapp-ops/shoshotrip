# ShoSho Trip — static export hosting rules (Apache / LiteSpeed, e.g. Hostinger)

Options -Indexes
DirectoryIndex index.html

# Custom 404 (Next emits /404.html on export)
ErrorDocument 404 /404.html

# Never serve the lead secrets or the local lead log
<FilesMatch "^(lead\.config\.php|leads\.log)$">
  Require all denied
</FilesMatch>

# Admin secrets: the GitHub token, the password hash and the lockout counter.
# admin-api.php includes these itself, so nothing needs to fetch them over HTTP.
<FilesMatch "^(admin\.config\.php|admin\.auth\.php|admin\.lockout\.json)$">
  Require all denied
</FilesMatch>

# Long-cache the immutable build assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  # HTML must never be cached: each deploy ships new hashed asset URLs, so a
  # stale HTML page would keep loading the old CSS/JS. Always revalidate.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Force HTML documents (incl. directory index requests like /ua/) to
  # revalidate so visitors pick up new deploys without a hard refresh.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip where available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
