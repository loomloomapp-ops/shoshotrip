# ShoSho Trip — static export hosting rules (Apache / LiteSpeed, e.g. Hostinger)

Options -Indexes
DirectoryIndex index.html

# Custom 404 (Next emits /404.html on export)
ErrorDocument 404 /404.html

# Never serve the lead secrets or the local lead log
<FilesMatch "^(lead\.config\.php|leads\.log)$">
  Require all denied
</FilesMatch>

# Long-cache the immutable build assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Gzip where available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
