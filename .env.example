# ShoSho Trip — environment configuration example.
# Copy to .env.local and fill real values. Never commit .env.local.

# ---- Public site config (safe to expose to the browser) ----
NEXT_PUBLIC_SITE_URL=https://shoshotrip.com
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/shosho.trip

# ---- Content panel (/admin) ----
# Which repository the panel commits content to. It only ever writes the JSON
# files under src/content/data/ and images under public/media/uploads/.
NEXT_PUBLIC_ADMIN_REPO=loomloomapp-ops/shoshotrip
NEXT_PUBLIC_ADMIN_BRANCH=main

# ---- Analytics (leave empty to disable) ----
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# ---- Lead delivery (server-only secrets, NEVER prefixed with NEXT_PUBLIC_) ----
# Telegram bot: create a bot with @BotFather, put token + target chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic outbound webhook (CRM / Zapier / Make / n8n). Leave empty to skip.
LEAD_WEBHOOK_URL=

# Email delivery (optional SMTP relay or transactional API key).
LEAD_EMAIL_TO=
LEAD_EMAIL_API_KEY=

# Google Sheets (optional; via Apps Script web app or service integration).
GOOGLE_SHEETS_WEBHOOK_URL=
